# ── OpenAI API ─────────────────────────────────────────────────────────────────
# Your API key for the provider you want to use.
OPENAI_API_KEY=your_api_key_here

# Base URL of the API endpoint.
# Change this to match whichever provider or local server you are using.
# The default below uses the official OpenAI endpoint.
#
# ┌─────────────────────────────────────────────────────────────────────┐
# │ Provider examples                                                   │
# ├─────────────────────────────────────────────────────────────────────┤
# │ OpenAI (default)   https://api.openai.com/v1                        │
# │ DeepSeek           https://api.deepseek.com/v1                      │
# │ Azure OpenAI       https://<resource>.openai.azure.com/openai/...   │
# │ Ollama (local)     http://localhost:11434/v1                         │
# │ LM Studio (local)  http://localhost:1234/v1                          │
# └─────────────────────────────────────────────────────────────────────┘
OPENAI_BASE_URL=https://api.openai.com/v1

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3001

# ── Context management ─────────────────────────────────────────────────────────
# When CONTEXT_SHIFT=true, the backend trims the conversation history before
# each API call so it never exceeds CONTEXT_SIZE messages.
# The most recent messages are kept; the system message (if any) is always
# preserved. These are server-side defaults — the frontend toggle/input
# overrides them per session.
CONTEXT_SHIFT=false
CONTEXT_SIZE=20

# ── Model list ─────────────────────────────────────────────────────────────────
# Comma-separated list of model IDs to expose in the UI dropdown.
# Must match the model IDs accepted by your chosen endpoint.
#
# OpenAI models (default when MODELS is omitted):
MODELS=gpt-4o,gpt-4o-mini,gpt-4-turbo,gpt-3.5-turbo
#
# DeepSeek models — use with OPENAI_BASE_URL=https://api.deepseek.com/v1
# MODELS=deepseek-chat,deepseek-reasoner
#
# Ollama / LM Studio — replace with the model names you have pulled locally
# MODELS=llama3,mistral,phi3
