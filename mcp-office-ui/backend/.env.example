# ── OpenAI API ─────────────────────────────────────────────────────────────────
# Required: your OpenAI API key
OPENAI_API_KEY=your_openai_api_key_here

# Optional: override the API base URL.
# Use this to point at a self-hosted, Azure OpenAI, or compatible proxy endpoint.
# Defaults to the official OpenAI endpoint when omitted.
OPENAI_BASE_URL=https://api.openai.com/v1

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3001

# ── Model list ─────────────────────────────────────────────────────────────────
# Comma-separated list of model IDs to expose in the UI dropdown.
# Any model ID accepted by your API endpoint can be listed here.
# If omitted, the built-in default list is used: gpt-4o, gpt-4o-mini,
# gpt-4-turbo, gpt-3.5-turbo.
MODELS=gpt-4o,gpt-4o-mini,gpt-4-turbo,gpt-3.5-turbo
