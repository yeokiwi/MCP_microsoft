DEEPSEEK_API_KEY=your_deepseek_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
GLM_API_KEY=your_glm_api_key_here
PORT=3001

# ── LLM base URLs ──────────────────────────────────────────────────────────────
# Override these to point at a self-hosted, proxy, or alternative endpoint.
# The defaults below are the official public API endpoints.
DEEPSEEK_BASE_URL=https://api.deepseek.com
MISTRAL_BASE_URL=https://api.mistral.ai/v1
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ── Model list ─────────────────────────────────────────────────────────────────
# Comma-separated list of model IDs to expose in the UI.
# The provider is inferred from the model name prefix:
#   deepseek-*        → DeepSeek (uses DEEPSEEK_API_KEY + DEEPSEEK_BASE_URL)
#   mistral-* / open-mistral-* / open-mixtral-*  → Mistral (uses MISTRAL_API_KEY + MISTRAL_BASE_URL)
#   glm-*             → GLM / Zhipu AI (uses GLM_API_KEY + GLM_BASE_URL)
# Add any model ID supported by your provider — the backend routes it automatically.
# If this variable is omitted, a built-in default list is used.
MODELS=deepseek-chat,deepseek-reasoner,mistral-small-latest,mistral-large-latest,open-mistral-7b,open-mixtral-8x7b,glm-4,glm-4-flash,glm-4-air
