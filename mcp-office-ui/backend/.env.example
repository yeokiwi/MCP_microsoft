DEEPSEEK_API_KEY=your_deepseek_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
GLM_API_KEY=your_glm_api_key_here
PORT=3001

# Comma-separated list of model IDs to expose in the UI.
# The provider is inferred from the model name prefix:
#   deepseek-*        → DeepSeek (uses DEEPSEEK_API_KEY)
#   mistral-* / open-mistral-* / open-mixtral-*  → Mistral (uses MISTRAL_API_KEY)
#   glm-*             → GLM / Zhipu AI (uses GLM_API_KEY)
# Add any model ID supported by your provider — the backend routes it automatically.
# If this variable is omitted, a built-in default list is used.
MODELS=deepseek-chat,deepseek-reasoner,mistral-small-latest,mistral-large-latest,open-mistral-7b,open-mixtral-8x7b,glm-4,glm-4-flash,glm-4-air
